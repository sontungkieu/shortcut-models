      "hidden": 160,
      "fm_steps": 1200,
      "router_steps": 800,
      "seed": 402,
      "variant_configs": [
        "gaussian:none:gaussian:1:1.0:default:uniform",
        "t1_tau10:split_lw8:distilled:1:1.0:default:uniform",
        "t2_tau05:split_lw8:distilled:2:0.5:default:uniform",
        "t2_tau10:split_lw8:distilled:2:1.0:default:uniform",
        "t2_tau15:split_lw8:distilled:2:1.5:default:uniform",
        "t4_tau10:split_lw8:distilled:4:1.0:default:uniform",
        "t8_tau10:split_lw8:distilled:8:1.0:default:uniform"
      ]
    },
    {
      "run_name": "toyfm-retune-image-pca32-k32",
      "datasets": "mnist,fashion_mnist",
      "pca_dim": 32,
      "gmm_modes": 32,
      "n_train": 18000,
      "n_valid": 4000,
      "hidden": 160,
      "fm_steps": 1200,
      "router_steps": 800,
      "seed": 403,
      "variant_configs": [
        "gaussian:none:gaussian:1:1.0:0.0003:uniform",
        "lr3e4_uniform:split_lw8:distilled:2:1.0:0.0003:uniform",
        "lr1e4_uniform:split_lw8:distilled:2:1.0:0.0001:uniform",
        "lr5e5_uniform:split_lw8:distilled:2:1.0:0.00005:uniform",
        "lr1e4_beta13:split_lw8:distilled:2:1.0:0.0001:beta13",
        "lr1e4_beta31:split_lw8:distilled:2:1.0:0.0001:beta31",
        "lr1e4_beta22:split_lw8:distilled:2:1.0:0.0001:beta22"
      ]
    },
    {
      "run_name": "toyfm-cifar-source-pca48-k64",
      "datasets": "cifar10",
      "pca_dim": 48,
      "gmm_modes": 64,
      "n_train": 16000,
      "n_valid": 3500,
      "gmm_iters": 30,
      "hidden": 192,
      "batch_size": 192,
      "fm_steps": 1000,
      "router_steps": 650,
      "seed": 501,
      "variant_configs": [
        "gaussian:none:gaussian:1:1.0:default:uniform",
        "direct_split:split_lw8:direct:1:1.0:default:uniform",
        "distill_split_t2:split_lw8:distilled:2:1.0:default:uniform",
        "oracle_split_t2:split_lw8:oracle:2:1.0:default:uniform",
        "t1_tau10:split_lw8:distilled:1:1.0:default:uniform",
        "t4_tau10:split_lw8:distilled:4:1.0:default:uniform",
        "lr1e4_beta13:split_lw8:distilled:2:1.0:0.0001:beta13",
        "lr1e4_beta31:split_lw8:distilled:2:1.0:0.0001:beta31"
